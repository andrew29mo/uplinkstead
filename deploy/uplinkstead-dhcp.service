[Unit]
Description=Uplinkstead single DHCP uplink lifecycle (experimental)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m uplinkstead.dhcp_service --config /etc/uplinkstead/dhcp.json --state /var/lib/uplinkstead-dhcp --socket /run/uplinkstead-dhcp/events.sock
StateDirectory=uplinkstead-dhcp
StateDirectoryMode=0700
RuntimeDirectory=uplinkstead-dhcp
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
