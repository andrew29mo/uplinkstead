[Unit]
Description=Uplinkstead dual-DHCP authoritative writer
Wants=uplinkstead-dual-policy.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
Group=uplinkstead
StateDirectory=uplinkstead-dual
StateDirectoryMode=0700
RuntimeDirectory=uplinkstead-dual
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/python3 -m uplinkstead.dual_dhcp_service --config /etc/uplinkstead/dual-dhcp.json --journal /var/lib/uplinkstead-dual --socket /run/uplinkstead-dual/private/events.sock --hook /usr/libexec/uplinkstead-dual-hook.py --client /usr/libexec/uplinkstead-busybox --policy-user uplinkstead --control-socket /run/uplinkstead-dual/control.sock
ExecStopPost=/usr/bin/python3 -m uplinkstead.dual_dhcp_stop --config /etc/uplinkstead/dual-dhcp.json --journal /var/lib/uplinkstead-dual
Restart=on-failure
RestartSec=2
KillMode=control-group
TimeoutStartSec=45
TimeoutStopSec=30
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
